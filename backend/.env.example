# Copy to backend/.env and fill in. Never commit the real file.

# Service-account JSON key (operator setup step 4, README)
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# The converted copy of the reference workbook, shared with the service account as Editor
TEST_SHEET_ID=

# S1 registry: the only spreadsheet ids the system may open (comma-separated). TEST_SHEET_ID is
# always included.
ENROLLED_SHEET_IDS=

# Snapshot encryption (Fernet). Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SNAPSHOT_KEY=
SNAPSHOT_KEY_ID=k1
SNAPSHOT_DIR=var/snapshots
SNAPSHOT_RETENTION_DAYS=30

# S2: registry database + queue (docker compose sets these for its own services)
DATABASE_URL=postgresql+psycopg://sheets:sheets@localhost:5432/sheets
REDIS_URL=redis://localhost:6379/0
ORG_ID=org_default
POLL_INTERVAL_SECONDS=30
DEBOUNCE_SECONDS=30

# S3: onboarding agent (OpenAI). Model IDs are checked against your account before use.
OPENAI_API_KEY=
LLM_PRIMARY_MODEL=gpt-4.1-mini
LLM_ESCALATION_MODEL=gpt-4.1
